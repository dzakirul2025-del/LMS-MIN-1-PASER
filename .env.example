# ==========================================
# KONFIGURASI ENVIRONMENT LMS MIN 1 PASER
# ==========================================
# Catatan: Jangan memasukkan kunci rahasia asli ke file ini atau repositori publik.

# Base URL aplikasi (AI Studio runtime atau Vercel)
APP_BASE_URL="http://localhost:3000"
APP_URL="MY_APP_URL"

# Integrasi Google Apps Script (Web App URL yang dideploy)
# Contoh: https://script.google.com/macros/s/AKfycb.../exec
GAS_WEB_APP_URL=""

# Shared Secret Server-to-Server antara Vercel/Express dan Apps Script
# Harus sama dengan LMS_API_SECRET yang diset di Google Apps Script Script Properties
GAS_SHARED_SECRET="min1paser-lms-super-secret-key-change-me"

# Secret untuk enkripsi/tanda tangan sesi HttpOnly
SESSION_SECRET="session-secret-min1paser-fase-c-kelas-6"

# Pepper rahasia di server untuk HMAC-SHA-256 kode akses siswa
STUDENT_CODE_PEPPER="pepper-min1paser-student-access-code"

# Google OAuth 2.0 untuk Super Admin Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""

# Daftar Email Super Admin yang diizinkan (pisahkan dengan koma)
# Default resmi: dzakirul2025@gmail.com
ADMIN_EMAILS="dzakirul2025@gmail.com"

# Port server
PORT=3000
